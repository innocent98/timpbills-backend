# Timpbills backend — env template
#
# Local dev (poetry): copy to `.env`, fill in dev values, keep gitignored.
# Staging / production: edit decrypted `.env.staging` / `.env.production`,
# then `./scripts/env.sh encrypt <env>` and commit the `.enc` file.

# ── Application identity ─────────────────────────────────────────────────────
PROJECT_NAME=timpbills-backend
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true

# ── Docker compose (unused for local poetry; required for staging/prod) ─────
# Staging:    COMPOSE_PROJECT_NAME=timpbills-staging  API_PORT=8001
# Production: COMPOSE_PROJECT_NAME=timpbills          API_PORT=8000
COMPOSE_PROJECT_NAME=timpbills
API_PORT=8000

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=http://localhost
SERVER_PORT=8000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-48-char-random-string-for-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Database ─────────────────────────────────────────────────────────────────
# Local poetry (host-mapped 5433): postgresql://timpbills:timpbills_dev@localhost:5433/timpbills
# Docker compose:                  postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:5432/${POSTGRES_DB}
DATABASE_URL=postgresql://timpbills:timpbills_dev@localhost:5433/timpbills
POSTGRES_USER=timpbills
POSTGRES_PASSWORD=timpbills_dev
POSTGRES_DB=timpbills
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────────────────────
# Local poetry (host-mapped 6380): redis://localhost:6380/0
# Docker compose:                  redis://:${REDIS_PASSWORD}@redis:6379/0
REDIS_URL=redis://localhost:6380/0
REDIS_PASSWORD=

# ── Termii SMS (phone OTP verification — DND/N-Alert route) ─────────────────
# PRODUCTION-ONLY: Termii has NO sandbox. In dev/test the fake provider is used
# (FORCE_FAKE_PROVIDERS / non-prod ENVIRONMENT) and logs the code to stdout; the
# real client only runs in staging/production and spends real SMS credit on the
# first send. Do a single controlled live test to your own number before launch.
#
# TERMII_API_KEY:   live key from https://accounts.termii.com → API keys.
# TERMII_SENDER_ID: must be a Termii-APPROVED sender. Our account is approved on
#   the shared N-Alert DND route — keep this as "N-Alert" (the OTP message body
#   in app/integrations/termii/client.py is the verbatim Termii-approved
#   template and must not drift).
# TERMII_BASE_URL:  v3 host. The client normalises a trailing /api, so either
#   https://v3.api.termii.com or https://api.ng.termii.com/api works.
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert
TERMII_BASE_URL=https://v3.api.termii.com
TERMII_OTP_CHANNEL=dnd
# OTP_EXPIRE_MINUTES is coupled to the approved N-Alert template ("expires in
# 30 minutes"). Changing it means re-approving the template with Termii.
OTP_EXPIRE_MINUTES=30
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RESEND_DAILY_CAP=10

# ── Resend Email (OTP + receipts + referral notifications) ──────────────────
# Get from https://resend.com/api-keys. Domain must be DNS-verified.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@timpbills.com
EMAIL_FROM_NAME=Timpbills

# ── SMTP fallback (legacy; ignored when RESEND_API_KEY is set) ──────────────
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ── Admin user ───────────────────────────────────────────────────────────────
# Admins are NOT seeded from env. Create one explicitly after deploy:
#   docker compose -f docker-compose.prod.yml run --rm api \
#     python scripts/create_admin.py --email you@timpbills.com --full-name "Your Name"
# (There is intentionally no FIRST_SUPERUSER_* setting — see app/core/config.py.)

# ── Feature flags ────────────────────────────────────────────────────────────
# Forces Fake* clients even when keys are present. Must be false in prod.
FORCE_FAKE_PROVIDERS=false

# ── Paystack (wallet funding) ────────────────────────────────────────────────
# Dashboard → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_URL=
# Card-fee pass-through (wallet funding is break-even per PRD §6.3)
PAYSTACK_CARD_FEE_PERCENT=1.5
PAYSTACK_CARD_FEE_FIXED_NAIRA=100
PAYSTACK_CARD_FEE_FIXED_THRESHOLD_NAIRA=2500
PAYSTACK_CARD_FEE_CAP_NAIRA=2000
# Platform fee on wallet funding
WALLET_FUNDING_FEE_PERCENT=1.0
WALLET_FUNDING_FEE_CAP_NAIRA=500

# ── VTPass (airtime, data, electricity, cable) ──────────────────────────────
# Sandbox: https://sandbox.vtpass.com   Production: https://vtpass.com
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox.vtpass.com
# Shared secret for /webhooks/vtpass (VTPass doesn't sign bodies).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
VTPASS_WEBHOOK_SECRET=
VTPASS_SAMPLE_NUMBER=08011111111

# ── Firebase Cloud Messaging (push notifications) ────────────────────────────
# Provide one of these. Path to the service-account JSON OR inline JSON.
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=timpbills

# ── Cloudinary (Sprint 5c · profile avatar uploads) ─────────────────────────
# Dashboard → Settings → Access Keys.
# All three required; if any is missing, AvatarService skips SDK config and
# any upload attempt returns 502 AVATAR_UPLOAD_FAILED. Tests mock
# cloudinary.uploader.upload directly, so leave blank in CI / local dev.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Electricity transaction caps (Sprint 4) ─────────────────────────────────
# Single-tx max in naira. Override per DisCo as JSON: {"jos-electric": 50000}
ELECTRICITY_DEFAULT_CAP=
ELECTRICITY_DISCO_CAPS=

# ── Compose tuning (gunicorn + celery workers) ──────────────────────────────
WEB_CONCURRENCY=4
WORKER_CONCURRENCY=2

# ── Observability — Sentry ───────────────────────────────────────────────────
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0

# ── Backups (optional; uncomment to enable nightly cloud sync) ──────────────
# ENABLE_CLOUD_BACKUP=true
# CLOUD_PROVIDER=b2
# B2_BUCKET=timpbills-backups

# ── Auth migration (Phase A+B — phone-only auth + PIN login) ────────────────
# AUTH_STRICT_GATES: flip to true after ~80% mobile-version adoption.
# AUTH_PIN_LOGIN_ENABLED: kill switch for /auth/pin-login.
# TERMII_OTP_CHANNEL: `dnd` bypasses NCC DND registry (required for prod);
#   `generic` is cheaper but blocked for DND-registered numbers.
AUTH_STRICT_GATES=false
AUTH_PIN_LOGIN_ENABLED=true

