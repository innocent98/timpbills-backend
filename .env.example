# ─────────────────────────────────────────────────────────────────────────────
#  Timpbills backend — single env template. Used by both local (poetry) and
#  docker. Copy to `.env` and fill in real values.
#
#  docker-compose.yml overrides DATABASE_URL + REDIS_URL internally so this
#  file stays context-agnostic for everything else.
# ─────────────────────────────────────────────────────────────────────────────

# ── Application ──────────────────────────────────────────────────────────────
PROJECT_NAME=timpbills-backend
VERSION=0.1.0
API_V1_STR=/api/v1
ENVIRONMENT=development
DEBUG=true

# ── Server ───────────────────────────────────────────────────────────────────
SERVER_HOST=http://localhost
SERVER_PORT=8000

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a fresh value with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace-with-32-char-random-string-for-dev
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# ── CORS ─────────────────────────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (non-docker): points at host-mapped docker port 5433.
# Inside docker-compose: the compose file overrides this to service name "db".
DATABASE_URL=postgresql://timpbills:timpbills_dev@localhost:5433/timpbills
POSTGRES_USER=timpbills
POSTGRES_PASSWORD=timpbills_dev
POSTGRES_DB=timpbills
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# ── Redis ────────────────────────────────────────────────────────────────────
# Local dev: host-mapped 6380. Inside docker: overridden to service name "redis".
REDIS_URL=redis://localhost:6380/0

# ── Termii SMS (outbound OTP for phone verification) ─────────────────────────
# Get from: https://accounts.termii.com/ → API keys
# Leave blank in dev — FakeTermiiClient is used when unset.
# Sender ID must be pre-approved (1-2 weeks lead time in Nigeria).
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_BASE_URL=https://api.ng.termii.com/api

# ── Resend Email (outbound email OTP + welcome + ticket delivery) ────────────
# Get from: https://resend.com/api-keys
# Leave blank in dev — FakeEmailClient is used when unset.
# Domain must be verified in Resend dashboard (SPF + DKIM + DMARC DNS records).
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=noreply@timpbills.com
EMAIL_FROM_NAME=Timpbills

# ── Legacy SMTP (kept for back-compat; unused when RESEND_API_KEY is set) ────
SMTP_TLS=true
SMTP_PORT=587
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=

# ── Admin user (required for app startup) ────────────────────────────────────
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changethis

# ── Feature flags ────────────────────────────────────────────────────────────
# When true, forces FakeTermiiClient + FakeEmailClient even if API keys are set.
FORCE_FAKE_PROVIDERS=false

# ── Paystack (payments) ──────────────────────────────────────────────────────
# Get from: https://dashboard.paystack.com → Settings → API Keys & Webhooks
# Leave blank in dev — FakePaystackClient is used when unset.
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
# URL Paystack will POST webhook events to. For local dev, point at your
# ngrok tunnel; for staging/prod use the real host.
PAYSTACK_WEBHOOK_URL=
# Fees applied by our platform on top of Paystack's charge — see PRD §6.3.
WALLET_FUNDING_FEE_PERCENT=1.0
WALLET_FUNDING_FEE_CAP_NAIRA=500

# ── VTPass (bill payments: airtime, data, electricity, cable TV) ────────────
# Sign up at https://sandbox.vtpass.com (sandbox) or https://vtpass.com (prod).
# Dashboard → API Keys → copy all three values.
# Leave blank in dev — FakeVTPassClient is used when unset.
VTPASS_API_KEY=
VTPASS_PUBLIC_KEY=
VTPASS_SECRET_KEY=
VTPASS_BASE_URL=https://sandbox-api.vtpass.com
# Shared secret for the /webhooks/vtpass endpoint — we check this header
# ourselves (VTPass doesn't sign webhook bodies). Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VTPASS_WEBHOOK_SECRET=

# ── Firebase Cloud Messaging (push notifications) ────────────────────────────
# Either provide a path to the service-account JSON file:
#   FCM_CREDENTIALS_PATH=/run/secrets/firebase-sa.json
# Or inline the JSON (useful for CI / env-only secrets stores):
#   FCM_CREDENTIALS_JSON='{"type":"service_account",...}'
# Leave both blank in dev — FakePushClient is used when unset.
# FCM_PROJECT_ID defaults to "timpbills"; override only if using a different
# Firebase project (e.g. staging-timpbills).
FCM_CREDENTIALS_PATH=
FCM_CREDENTIALS_JSON=
FCM_PROJECT_ID=

# ── Electricity purchase caps (Sprint 4) ─────────────────────────────────────
# Max single-transaction amount (naira) for electricity purchases. Default is
# ₦200,000. Individual DisCos that impose tighter limits can be overridden via
# ELECTRICITY_DISCO_CAPS as a JSON dict, e.g.:
#   ELECTRICITY_DISCO_CAPS={"jos-electric": 50000}
# Leave both unset to use the in-code defaults.
ELECTRICITY_DEFAULT_CAP=
ELECTRICITY_DISCO_CAPS=

# ── Observability — Sentry ───────────────────────────────────────────────────
# Leave DSN empty in dev/test — the SDK becomes a no-op.
# In staging/prod: https://sentry.io → project → settings → Client Keys (DSN).
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
