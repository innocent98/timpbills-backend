# Docker-compose env template. Copy to .env.docker and fill in real values.

# App
ENVIRONMENT=dev
SECRET_KEY=replace-with-32-char-random-string-for-dev
DEBUG=true

# Database (inside docker network; port 5432 NOT 5433)
POSTGRES_USER=timpbills
POSTGRES_PASSWORD=timpbills_dev
POSTGRES_DB=timpbills
DATABASE_URL=postgresql://timpbills:timpbills_dev@db:5432/timpbills

# Redis (inside docker network; port 6379 NOT 6380)
REDIS_URL=redis://redis:6379/0

# Termii (optional for dev — FakeTermiiClient is used when these are unset)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Admin user (required for app startup)
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_PASSWORD=changeme
